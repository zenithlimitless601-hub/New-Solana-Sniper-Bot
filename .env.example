APP_NAME=Solana Sniper Bot
DATABASE_URL=sqlite+aiosqlite:///./data.db

# Solana RPC endpoints (paid RPC recommended for logsSubscribe)
RPC_WS_URL=wss://api.mainnet-beta.solana.com
RPC_HTTP_URL=https://api.mainnet-beta.solana.com

# Pump.fun real-time listener
PUMPFUN_ENABLED=false
MONITOR_ENABLED=false

# Trading strategy
TRADE_MODE=simulation
ENTRY_AMOUNT_USD=50
TAKE_PROFIT_MULTIPLIERS_CSV=2.0,3.0,5.0
STOP_LOSS=0.3
RISK_THRESHOLD=0.6

# AI analyzer (rule | openai)
AI_MODEL=rule
OPENAI_API_KEY=

# Price provider (mock for simulation)
PRICE_PROVIDER=mock

# Logging
LOG_LEVEL=INFO
LOG_TO_FILE=false

# Admin panel
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme
